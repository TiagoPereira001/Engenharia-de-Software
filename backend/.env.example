# Copiar para .env e mudar os valores. O .env nunca vai para o Git.
DJANGO_SECRET_KEY=muda-isto
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Com POSTGRES_HOST definido usa PostgreSQL (é o que o docker-compose.yml faz); sem ele, SQLite.
# POSTGRES_HOST=localhost
# POSTGRES_DB=pedidos
# POSTGRES_USER=pedidos
# POSTGRES_PASSWORD=muda-isto
