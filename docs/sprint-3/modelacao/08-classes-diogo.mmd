%% Classes que o Diogo Martins (programador) usa. Mesmos nomes e relações do 08-classes.mmd.
classDiagram
    class Utilizador {
        <<no código>>
        username
        email
        papel
        gere_pedidos() bool
    }
    class Pedido {
        <<no código>>
        titulo
        descricao
        estado
        origem
        criado_em
        atualizado_em
    }
    class MudancaEstado {
        <<no código>>
        de
        para
        motivo
        quando
    }
    class Comentario {
        <<desenho>>
        texto
        criado_em
    }
    class UserStory {
        <<desenho>>
        texto
    }
    class CriterioAceitacao {
        <<desenho>>
        texto
    }
    Utilizador "1" --> "*" Pedido : submete (autor)
    Pedido "1" *-- "*" MudancaEstado : histórico
    Utilizador "1" --> "*" MudancaEstado : faz (autor)
    Pedido "1" *-- "*" Comentario : tem
    Utilizador "1" --> "*" Comentario : escreve
    Pedido "1" --> "*" UserStory : gera
    UserStory "1" *-- "*" CriterioAceitacao : tem
