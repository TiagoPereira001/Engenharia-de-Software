%% Classes que a Helena Costa (gestora de projeto) usa. Mesmos nomes e relações do 08-classes.mmd.
classDiagram
    class Utilizador {
        <<no código>>
        username
        email
        papel
        gere_pedidos() bool
    }
    class Equipa {
        <<desenho>>
        nome
    }
    class Pedido {
        <<no código>>
        titulo
        descricao
        estado
        origem
        criado_em
        atualizado_em
    }
    class MudancaEstado {
        <<no código>>
        de
        para
        motivo
        quando
    }
    class UserStory {
        <<desenho>>
        texto
    }
    class Release {
        <<desenho>>
        nome
        data
    }
    class Sprint {
        <<desenho>>
        nome
        inicio
        fim
    }
    Utilizador "1" --> "*" Pedido : submete (autor)
    Pedido "1" *-- "*" MudancaEstado : histórico
    Utilizador "1" --> "*" MudancaEstado : faz (autor)
    Pedido "1" --> "*" UserStory : gera
    Sprint "1" o-- "*" UserStory : inclui
    Release "1" o-- "*" Pedido : entrega
    Equipa "1" o-- "*" Utilizador : tem
