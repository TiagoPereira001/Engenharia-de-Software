%% Diagrama de classes (modelo de domínio), igual ao modelo de dados (07). «no código» = já existe em backend/contas/models.py e backend/pedidos/models.py; «desenho» = entra nos próximos sprints.
%% As vistas por persona estão em 08-classes-sofia/marta/ricardo/diogo/helena.mmd.
classDiagram
    class Utilizador {
        <<no código>>
        username
        email
        papel
        gere_pedidos() bool
    }
    class Categoria {
        <<no código>>
        nome
    }
    class Pedido {
        <<no código>>
        titulo
        descricao
        estado
        origem
        criado_em
        atualizado_em
    }
    class Voto {
        <<no código>>
        criado_em
    }
    class MudancaEstado {
        <<no código>>
        de
        para
        motivo
        quando
    }
    class Comentario {
        <<desenho>>
        texto
        criado_em
    }
    class UserStory {
        <<desenho>>
        texto
    }
    class CriterioAceitacao {
        <<desenho>>
        texto
    }
    class Equipa {
        <<desenho>>
        nome
    }
    class Sprint {
        <<desenho>>
        nome
        inicio
        fim
    }
    class Release {
        <<desenho>>
        nome
        data
    }
    class Notificacao {
        <<desenho>>
        texto
        lida
    }
    Utilizador "1" --> "*" Pedido : submete (autor)
    Categoria "1" --> "*" Pedido : classifica
    Pedido "1" *-- "*" Voto : recebe
    Utilizador "1" --> "*" Voto : dá
    Pedido "1" *-- "*" MudancaEstado : histórico
    Utilizador "1" --> "*" MudancaEstado : faz (autor)
    Pedido "1" *-- "*" Comentario : tem
    Utilizador "1" --> "*" Comentario : escreve
    Pedido "1" --> "*" UserStory : gera
    UserStory "1" *-- "*" CriterioAceitacao : tem
    Sprint "1" o-- "*" UserStory : inclui
    Release "1" o-- "*" Pedido : entrega
    Equipa "1" o-- "*" Utilizador : tem
    Utilizador "1" --> "*" Notificacao : recebe
