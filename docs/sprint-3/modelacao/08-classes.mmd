%% Diagrama de classes (modelo de domínio). Utilizador, Pedido, Categoria, Voto e MudancaEstado já existem no código.
classDiagram
    class Utilizador {
        username
        email
        papel
        gere_pedidos() bool
    }
    class Pedido {
        titulo
        descricao
        estado
        origem
        criado_em
    }
    class Categoria {
        nome
    }
    class Voto {
        criado_em
    }
    class MudancaEstado {
        de
        para
        motivo
        quando
    }
    class Comentario {
        texto
        criado_em
    }
    class UserStory {
        texto
    }
    class CriterioAceitacao {
        texto
    }
    class Equipa {
        nome
    }
    class Sprint {
        nome
        inicio
        fim
    }
    class Release {
        nome
        data
    }
    class Notificacao {
        texto
        lida
    }
    Utilizador "1" --> "*" Pedido : submete
    Categoria "1" --> "*" Pedido : classifica
    Pedido "1" *-- "*" Voto
    Utilizador "1" --> "*" Voto : dá
    Pedido "1" *-- "*" MudancaEstado : histórico
    Pedido "1" *-- "*" Comentario
    Pedido "1" --> "*" UserStory : gera
    UserStory "1" *-- "*" CriterioAceitacao
    Sprint "1" o-- "*" UserStory
    Release "1" o-- "*" Pedido
    Equipa "1" o-- "*" Utilizador
    Utilizador "1" --> "*" Notificacao : recebe
