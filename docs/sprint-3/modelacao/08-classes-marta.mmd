%% Classes que a Marta Lopes (product manager) usa. Mesmos nomes e relações do 08-classes.mmd.
classDiagram
    class Utilizador {
        <<no código>>
        username
        email
        papel
        gere_pedidos() bool
    }
    class Pedido {
        <<no código>>
        titulo
        descricao
        estado
        origem
        criado_em
        atualizado_em
    }
    class Categoria {
        <<no código>>
        nome
    }
    class MudancaEstado {
        <<no código>>
        de
        para
        motivo
        quando
    }
    class Comentario {
        <<desenho>>
        texto
        criado_em
    }
    class Release {
        <<desenho>>
        nome
        data
    }
    Utilizador "1" --> "*" Pedido : submete (autor)
    Categoria "1" --> "*" Pedido : classifica
    Pedido "1" *-- "*" MudancaEstado : histórico
    Utilizador "1" --> "*" MudancaEstado : faz (autor)
    Pedido "1" *-- "*" Comentario : tem
    Utilizador "1" --> "*" Comentario : escreve
    Release "1" o-- "*" Pedido : entrega
